            <description>&lt;style&gt;
body {
  color-scheme: light dark;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 12px;
  line-height: 1.45;
  color: #1d1d1f;
