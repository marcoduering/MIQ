        <item>
            <title>1.8.0</title>
            <pubDate>Sat, 31 Oct 2026 14:31:30 +0100</pubDate>
            <link>https://miq.marco-duering.net/</link>
            <sparkle:fullReleaseNotesLink>https://github.com/marcoduering/MIQ/releases</sparkle:fullReleaseNotesLink>
            <sparkle:version>1.8.0</sparkle:version>
            <sparkle:shortVersionString>1.8.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description>&lt;style&gt;
body { line-height: 1.45; margin: 10px 12px; }
h1, h2, h3 { font-size: 1em; font-weight: 600; margin: 14px 0 4px; }
h1:first-child, h2:first-child, h3:first-child, p:first-child { margin-top: 0; }
p { margin: 0 0 8px; }
ul, ol { margin: 0 0 10px; padding-left: 20px; }
li { margin: 2px 0; }
code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.92em; background: rgba(128,128,128,.14);
  border-radius: 3px; padding: 1px 4px;
}
&lt;/style&gt;
&lt;p dir="auto"&gt;&lt;strong&gt;New features:&lt;/strong&gt;&lt;/p&gt;
&lt;ul dir="auto"&gt;
&lt;li&gt;&lt;strong&gt;ITK MetaImage support&lt;/strong&gt;: self-contained &lt;code class="notranslate"&gt;.mha&lt;/code&gt; files, raw or compressed.&lt;/li&gt;
&lt;li&gt;New metadata rows: &lt;strong&gt;Voxel index&lt;/strong&gt; (the crosshair voxel, in the file's own axis order) and &lt;strong&gt;Comment&lt;/strong&gt; (the header's description text; off by default, turn it on in Settings ▸ Metadata).&lt;/li&gt;
&lt;li&gt;When a NIfTI file's sform and qform disagree on orientation, the Orientation row shows both, e.g. "LAS (qform: RAS)".&lt;/li&gt;
&lt;li&gt;Configurable size limit for "Ask before loading network files" (Settings ▸ Preview), from 50 MB to Never.&lt;/li&gt;
&lt;/ul&gt;
&lt;p dir="auto"&gt;&lt;strong&gt;Other:&lt;/strong&gt;&lt;/p&gt;
&lt;ul dir="auto"&gt;
&lt;li&gt;Thumbnails settings: new &lt;strong&gt;Clear thumbnail cache&lt;/strong&gt; row.&lt;/li&gt;
&lt;/ul&gt;</description>
            <enclosure url="https://github.com/marcoduering/MIQ/releases/download/v1.8.0/MIQ.app.zip" length="4800939" type="application/octet-stream" sparkle:edSignature="swc4QTdePhwE7Dsraj8eIInPGgTkMveFHigIDSJUQNh6+Z0IoHI1oL0tZOOE6utBhmCoLwWeQvPU1btDchO8CA==" />
        </item>
